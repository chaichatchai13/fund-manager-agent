# Schwab API credentials (from developer.schwab.com)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
# Use a port that does NOT conflict with the app (app runs on 8443)
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=./schwab_token.json

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL database credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=MYPASSWORD

# Set to "true" to use mock Schwab client (no real API calls)
MOCK_SCHWAB=false

# App settings
LOG_LEVEL=INFO
ENVIRONMENT=development
