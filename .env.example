# ─── Schwab API ───────────────────────────────────────────────────────────────
SCHWAB_APP_KEY=your_schwab_app_key_here
SCHWAB_APP_SECRET=your_schwab_app_secret_here
SCHWAB_CALLBACK_URL=https://yourdomain.com/api/schwab/callback
SCHWAB_TOKEN_PATH=/app/schwab_token.json

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# DB_HOST is overridden to "db" by docker-compose — no need to change this
DB_HOST=db
DB_PORT=5432
DB_NAME=thetaflow
DB_USER=thetaflow
DB_PASS=change_this_to_a_strong_random_password

# ─── Domain (used by Caddy for automatic HTTPS) ───────────────────────────────
# Production: your real domain e.g. thetaflow.yourdomain.com
# Local test: localhost  (Caddy will create a local cert — run: caddy trust)
THETAFLOW_DOMAIN=yourdomain.com

# ─── App settings ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
MOCK_SCHWAB=false

# ─── ThetaFlow Auth ───────────────────────────────────────────────────────────
# Your login password — plain text or bcrypt hash (both accepted)
# To generate a bcrypt hash:
#   python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
THETAFLOW_PASSWORD=change_this_password

# Random secret for signing JWT tokens — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

# ─── Twilio (SMS alerts + two-way agent conversation) ────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567
ALERT_PHONE_NUMBER=+15557654321

# ─── Brave Search API (research skill — free 2k queries/month) ───────────────
# Get at: https://brave.com/search/api
BRAVE_API_KEY=your_brave_api_key_here

# ─── SocialData.tools (X.com post fetching — usage-based ~$1-3/month) ────────
# Get at: https://socialdata.tools
SOCIALDATA_API_KEY=your_socialdata_api_key_here

# ─── PWA Push Notifications (VAPID keys) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@thetaflow.app
